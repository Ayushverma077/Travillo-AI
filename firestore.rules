rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Validation for User Profile
    function isValidUserProfile(data, userId) {
      return data.uid is string && data.uid == userId &&
             data.email is string && data.email.size() <= 256;
    }

    // Validation for Trip
    function isValidTrip(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() <= 200 &&
             data.destination is string && data.destination.size() <= 150 &&
             data.duration is number && data.duration >= 1 && data.duration <= 30;
    }

    // Validation for Favorite
    function isValidFavorite(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.destinationId is string && data.destinationId.size() <= 128 &&
             data.destinationName is string && data.destinationName.size() <= 150;
    }

    // Connection testing endpoint for health check
    match /test/connection {
      allow read: if true;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User saved trips subcollection
      match /trips/{tripId} {
        allow get: if isOwner(userId) && isValidId(tripId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(tripId) && isValidTrip(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(tripId) && isValidTrip(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(tripId);
      }

      // User favorites subcollection
      match /favorites/{destinationId} {
        allow get: if isOwner(userId) && isValidId(destinationId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(destinationId) && isValidFavorite(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(destinationId) && isValidFavorite(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(destinationId);
      }
    }
  }
}
